# =============================================================================
# MONDE DES TÉNÈBRES - CONFIGURATION BOT & API
# =============================================================================
# Copiez ce fichier vers .env et renseignez vos valeurs réelles.

# 1. Token obligatoire de votre bot Discord (discord.com/developers/applications)
DISCORD_TOKEN=votre_token_secret_ici

# 2. Préfixe des commandes administratives Discord (ex: !reset, !grant_ritual)
COMMAND_PREFIX=!

# 3. Port d'écoute pour l'API REST locale (8080 par défaut)
PORT=8080

# 4. URL de l'application Web vers laquelle renvoyer les joueurs pour le choix de clan
WEB_URL=https://zaaees.github.io/the-world-of-darkness

# 5. Clé API Gemini (optionnelle pour assistants AI)
# GEMINI_API_KEY=votre_cle_gemini_ici
